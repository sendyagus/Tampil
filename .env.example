# TAMPIL - AI Communication Coach
# Environment Configuration Template

APP_ENV=development

# Konfigurasi AI API (jika nanti menggunakan Groq / OpenAI Whisper untuk Speech-to-Text)
# GROQ_API_KEY=your_groq_api_key_here

# URL server AI (FastAPI port 8000) untuk build Flutter:
# flutter run --dart-define=AI_SERVER_URL=http://IP-LAN-PC:8000
# Wajib diisi saat uji di HP fisik; emulator cukup 10.0.2.2 bawaan.

# ---- AI langsung di dalam aplikasi (tanpa menyalakan server) ----
# Bila kunci ini tersedia, aplikasi memanggil Groq sendiri sehingga server
# Python tidak perlu hidup. Isi langsung di berkas .env ini (berkas ini tidak
# ikut ter-commit), atau suntik saat build:
#   flutter build apk --dart-define=GROQ_API_KEY=gsk_xxx --dart-define=AI_MODE=direct
# Cara paling praktis di proyek ini: jalankan skrip di folder root
#   .\build_ai.ps1        (mengambil kunci dari server\.env otomatis)
# GROQ_API_KEY=your_groq_api_key_here

# AI_MODE=direct  -> paksa AI langsung, lewati pencarian server lokal
# kosong/tidak ada -> coba server lokal dulu, baru AI langsung
