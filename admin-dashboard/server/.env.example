# ===== TAMPIL CMS Server =====

# Port server API
PORT=4000

# Origin React dashboard (untuk CORS)
CLIENT_ORIGIN=http://localhost:5173

# ID Spreadsheet tempat data konten disimpan.
# Ambil dari URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=

# (Opsional) ID folder Google Drive untuk menyimpan gambar.
# Ambil dari URL folder Drive: https://drive.google.com/drive/folders/<FOLDER_ID>
DRIVE_FOLDER_ID=

# (Opsional) Path absolut ke file service account JSON.
# Jika kosong, server memakai ./credentials/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service-account.json

# (Opsional) Nama collection penanda admin. Default: cms_admins
# ADMIN_COLLECTION=cms_admins

# ===== Opsi autentikasi OAuth (pengganti service account key) =====
# Jalankan `npm run auth` setelah menaruh credentials/oauth-client.json.
# Port callback OAuth (harus sama dgn Authorized redirect URI client): default 8080
# OAUTH_REDIRECT_PORT=8080
# Project Firebase (untuk Firebase Admin). Default diambil dari oauth-client.json
# FIREBASE_PROJECT_ID=tampilapp
