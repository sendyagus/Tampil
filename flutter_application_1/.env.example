# TAMPIL - AI Communication Coach
# Environment Configuration Template

APP_ENV=development

# Konfigurasi AI API (jika nanti menggunakan Groq / OpenAI Whisper untuk Speech-to-Text)
# GROQ_API_KEY=your_groq_api_key_here

# Login Google di Android/iOS: tempel OAuth client ID bertipe "Web application"
# dari Firebase Console / Google Cloud Console. Web memakai popup Firebase
# sehingga tidak memerlukan nilai ini.
GOOGLE_SERVER_CLIENT_ID=your_web_oauth_client_id.apps.googleusercontent.com
